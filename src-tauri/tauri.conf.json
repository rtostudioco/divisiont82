{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DivisionT82",
  "version": "0.2.0",
  "identifier": "dev.divisiont82.shell",
  "build": {
    "beforeDevCommand": "bun run dev:ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DivisionT82",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Holographic desktop shell",
    "longDescription": "DivisionT82 transforms Windows and Linux into personalized holographic work environments: floating panels, smart widgets, theme packs and MCP-native extensibility.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
